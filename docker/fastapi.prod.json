{
    "database": {
        "storage": "sqlmodel"
    },
    "scheduler": {
        "max_history": 10000,
        "max_workers": 20,
        "history_retention_days": 8,
        "max_dead_letters": 500,
        "quiet": true
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s [%(levelname)s] %(name)s - %(message)s",
        "datefmt": "%Y-%m-%d %H:%M:%S",
        "console": true,
        "rotation": {
            "when": "midnight",
            "interval": 1,
            "backup_count": 30
        },
        "api": {
            "dir": "Log/api",
            "filename": "api.log"
        }
    },
    "api": {
        "host": "0.0.0.0",
        "port": 8000,
        "reload": false
    }
}